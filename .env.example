# Copy to .env and fill in. `make up` reads this file.

# --- Database -----------------------------------------------------------------
# Host port 5433 avoids colliding with a local Postgres on 5432.
DATABASE_URL=postgres://lyrics:lyrics@localhost:5433/lyrics?sslmode=disable

# --- Prelude Auth -------------------------------------------------------------
# The application identifier from the Prelude dashboard. It determines both the
# JWKS URL (https://<app_id>.session.prelude.dev/.well-known/jwks.json) and the
# expected token issuer, so it must match exactly.
PRELUDE_APP_ID=

# Management API key. Used server-side to create users and set their passwords;
# never expose this to the browser.
PRELUDE_API_KEY=

PRELUDE_API_BASE=https://api.prelude.dev

# The host the browser authenticates against. Registered on the application (see
# README, "Add a custom session domain") and left blank to fall back to
# <app_id>.session.prelude.dev. Prelude's issuer is per-host, so this one value
# decides both the SDK's domain and the `iss` the API expects — a bare host, with
# no scheme, which the API refuses at startup rather than deriving nonsense from.
PRELUDE_SESSION_DOMAIN=

# The email OTP login configuration password reset mails its code through
# (`lcfg_...`, from GET /v2/session/apps/<app_id>/config/login/otp). Reset has to
# name one because this configuration is deliberately not the application's
# default — see CLAUDE.md, "Password reset", for why an emailed code is a login
# here and why it is never offered as one. Reaches the build as
# NEXT_PUBLIC_PRELUDE_OTP_LOGIN_CONFIG_ID; without it the reset screen says it is not
# configured rather than asking Prelude for a code no configuration can send.
PRELUDE_OTP_LOGIN_CONFIG_ID=

# Escape hatches for offline development and tests: point token verification at
# a locally served key set instead of Prelude. Leave both blank in normal use —
# when empty, the JWKS URL and issuer are derived from PRELUDE_APP_ID.
PRELUDE_JWKS_URL=
PRELUDE_ISSUER=

# --- Authorization ------------------------------------------------------------
# Comma-separated emails promoted to `admin` the first time they sign in.
# Without at least one entry, no account can ever grant the admin role.
ADMIN_EMAILS=

# --- Server -------------------------------------------------------------------
PORT=8080
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# The one header trusted to carry the caller's address, for the registration rate
# limit. Blank is right whenever the API is reached directly, which is what local
# development does — the peer address is already the caller's.
#
# Set it only behind a proxy, and only to a header that proxy writes itself and
# overwrites on the way in: the limit is per key, so a header a client can set
# turns it into no limit at all. Behind your own nginx or Caddy that means
# whichever header you configure it to set. App Platform is `DO-Connecting-IP`
# and is already in `.do/app.yaml` — deliberately not `X-Forwarded-For`, which
# there carries the ingress's own address.
#
# Left blank behind a proxy, every caller shares one bucket of five per minute.
CLIENT_IP_HEADER=

# --- Frontend -----------------------------------------------------------------
# Only needed for development, where the dev server serves :5173 and the API
# listens on :8080. A production build with this unset targets its own origin,
# which is how the app is deployed — one domain, with /api routed to the API.
# `make mobile` sets it empty, which is not the same as unset: emptied, calls go
# to this origin and through the dev server's own /api rewrite.
#
# This one carries the framework prefix where the Prelude values below do not,
# because nothing maps it: the Makefile exports this file wholesale and the dev
# server reads NEXT_PUBLIC_* names as they stand. It reaches no deployment —
# production deliberately leaves it unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Publishable client identifier for the Prelude session SDK. Optional, and safe
# in the bundle — unlike PRELUDE_API_KEY above. Named without a framework prefix
# like every other Prelude value here: each mapping site adds one, so a future
# framework rename touches the repository and not this file.
PRELUDE_SDK_KEY=

# --- Deployment ---------------------------------------------------------------
# A DigitalOcean API token with write scope, read by scripts/deploy-do.sh. Leave
# blank unless you deploy from this machine; it can also be passed in the
# environment for a single command.
DIGITALOCEAN_ACCESS_TOKEN=
