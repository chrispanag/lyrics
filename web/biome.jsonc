{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  // The .gitignore that matters is the repository's, one level up.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!next-env.d.ts", "!**/*.md", "!.storybook/public"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  // Off: imports are grouped by hand (framework, packages, then `@/`), and
  // sorting them is a decision of its own rather than part of formatting.
  "assist": {
    "actions": { "source": { "organizeImports": "off" } }
  },
  "linter": {
    "rules": {
      // Every rule in the group, not only the recommended ones. CLAUDE.md says
      // what a suppression has to state.
      "a11y": "error",
      // Stated, not left to the React domain: without these lines neither fires
      // here (the suppressions they need go unused).
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        // What keeps component files exporting only components, which fast
        // refresh needs and the style modules in CLAUDE.md exist for.
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": { "allowConstantExport": true }
        },
        // The routing seam: react-router is reached through @/lib/navigation,
        // whose API `next/navigation` can implement too, so changing routers is
        // a change to that module. The route table and the harness's
        // `test/routes.tsx` are the only other importers (the override
        // below). See CLAUDE.md, "The routing seam".
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-router-dom": "Import routing from @/lib/navigation, the app's routing seam.",
              "react-router": "Import routing from @/lib/navigation, the app's routing seam."
            }
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        // `error` and `warn` stay: several failures are deliberately reported
        // only to the console, so that the screen can stay uniform.
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } },
        "noDeprecatedImports": "error",
        "noReactForwardRef": "error"
      },
      "security": {
        // Lyrics are contributor-typed text, so every raw HTML sink has to
        // say at its site why what it writes cannot carry markup.
        "noDangerouslySetInnerHtml": "error"
      },
      // Nursery rules move between releases, which is safe only because the
      // Biome version is pinned exactly in package.json.
      // Tried and left off, every finding wrong: useAwaitThenable,
      // noUnsafeReturn, useNullishCoalescing, noMisleadingReturnType.
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "useReactCompiler": "error"
      }
    }
  },
  "overrides": [
    {
      // The App Router's own export vocabulary, in the one directory that has
      // route files. Restated in full: an override's options replace the base
      // rule's rather than merging with them.
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowConstantExport": true,
                "allowExportNames": ["metadata", "viewport", "generateMetadata"]
              }
            }
          }
        }
      }
    },
    {
      // The route table, and the harness that stands in for it in specs and
      // stories. The seam itself says so in its own file.
      "includes": ["src/App.tsx", "src/test/routes.tsx"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // The routing seam exports its links beside its hooks on purpose: being
      // one module is what makes changing routers a one-file change. The cost
      // is a full reload rather than a fast refresh when this file is edited.
      "includes": ["src/lib/navigation.tsx"],
      "linter": { "rules": { "style": { "useComponentExportOnlyModules": "off" } } }
    },
    {
      // A command-line script, whose output is the console.
      "includes": ["icons/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Specs define throwaway components and are never fast-refreshed, and
      // index into fixtures they built themselves, which `noUncheckedIndexedAccess`
      // then makes them assert.
      // Stories are the same shape: a CSF file's exports are a meta object and
      // story objects, which is the format rather than a fast-refresh hazard.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx", ".storybook/**", "e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
