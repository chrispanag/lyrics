node_modules
# The build output, which the build stage regenerates. Left in the context it is
# tens of megabytes shipped to the daemon, and — because `next dev` rewrites it
# — it invalidates the `COPY . .` layer on builds where no source changed.
.next
coverage
# Icon *sources* and their generator. The rendered assets live in public/ and
# are tracked; nothing in the build re-renders them, so these would only ride
# along in the context.
icons
playwright-report
test-results
.env
.env.local
